---
import Wordmark from './Wordmark.astro';
import { useStrings } from '../i18n';

const { locale = 'en' } = Astro.props as { locale?: string };
const t = useStrings(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <Wordmark />
      <p>{t.footer.tagline}</p>
    </div>
    <nav aria-label="Footer">
      <a href="/demo/">{t.footer.demo}</a>
      <a href="/privacy">{t.footer.privacy}</a>
      <a href="/#waitlist">{t.nav.join}</a>
    </nav>
    <div class="fine">
      <p>{t.footer.credits}</p>
      <p>© {year} · {t.footer.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 56px 40px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 32px 48px;
  }

  .brand p {
    margin-top: 12px;
  }

  nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  nav a {
    color: var(--fg);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent-hover);
  }

  .fine {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
