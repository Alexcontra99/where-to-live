---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { CITIES } from '../config';
import { useStrings } from '../i18n';

const locale = Astro.currentLocale ?? 'en';
const t = useStrings(locale);
const layers = t.layers.items;
const live = t.live;
---

<Base title={t.meta.title} description={t.meta.description} locale={locale}>
  <section class="hero">
    <div class="wrap hero-copy">
      <h1>{t.hero.title}</h1>
      <p class="hero-lead">{t.hero.lead}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#waitlist">
          {t.hero.cta}
          <span class="arrow"><Icon name="arrow" size={14} /></span>
        </a>
        <a class="btn btn-quiet" href="/demo/">
          {t.hero.demo}
          <span class="arrow"><Icon name="external" size={14} /></span>
        </a>
      </div>
      <p class="status-line">
        <span class="dot" aria-hidden="true"></span>
        {t.hero.status}
      </p>
    </div>
  </section>

  <section class="story" id="how" aria-label={t.layers.label} data-story>
    <script type="application/json" id="live-strings" set:html={JSON.stringify(live)} />
    <div class="stage">
      <figure class="frame">
        <div class="frame-bar">
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
          <p><span class="dot" aria-hidden="true"></span>{live.frame}</p>
          <a class="frame-open" href="/demo/">
            {live.open}
            <Icon name="external" size={13} />
          </a>
        </div>
        <div class="map-shell">
          <div class="map" data-map role="region" aria-label={live.mapLabel} tabindex="0"></div>
          <picture class="poster" data-poster>
            <source media="(max-width: 640px)" srcset="/img/demo-mobile-780.webp" width="780" height="1688" />
            <img
              src="/img/demo-results-1200.webp"
              srcset="/img/demo-results-1200.webp 1200w, /img/demo-results-2400.webp 2400w"
              sizes="(max-width: 1260px) 92vw, 1180px"
              width="2400"
              height="1500"
              alt={t.hero.shotAlt}
              fetchpriority="high"
            />
          </picture>
          <p class="map-status" data-status role="status">{live.loading}</p>
          <div class="legend" data-legend aria-hidden="true"></div>
          <button class="move" type="button" data-move aria-pressed="false" hidden>{live.move}</button>
        </div>
        <nav class="dock" aria-label={t.layers.label}>
          {
            layers.map((l) => (
              <a class="tab" href={`#layer-${l.id}`} data-tab={l.id}>
                <Icon name={l.id as 'commute'} size={18} />
                <span>{l.name}</span>
              </a>
            ))
          }
        </nav>
      </figure>
    </div>

    <div class="steps">
      <div class="step intro" data-layer="overview">
        <div class="card" hidden data-controls>
          <p class="readout" data-readout="overview" aria-live="polite"></p>
        </div>
      </div>

      <article class="step" id="layer-commute" data-layer="commute">
        <div class="card">
          <h3>{layers[0]!.name}</h3>
          <p>{layers[0]!.text}</p>
          <div class="controls" data-controls hidden>
            <div class="ctl">
              <span class="ctl-label" id="lbl-who">{live.commute.who}</span>
              <div class="pills" role="group" aria-labelledby="lbl-who">
                {
                  Object.entries(live.commute.people).map(([id, name]) => (
                    <button type="button" class="pill-btn" data-k="persons" data-v={id} aria-pressed="true">
                      {name}
                    </button>
                  ))
                }
              </div>
            </div>
            <label class="ctl range">
              <span class="ctl-label">{live.commute.max} <output>30 min</output></span>
              <input type="range" min="10" max="60" step="5" value="30" data-k="max" data-fmt={live.commute.minutes} />
            </label>
          </div>
          <p class="readout" data-readout="commute" aria-live="polite"></p>
          <p class="source">{layers[0]!.source}</p>
        </div>
      </article>

      <article class="step" id="layer-rent" data-layer="rent">
        <div class="card">
          <h3>{layers[1]!.name}</h3>
          <p>{layers[1]!.text}</p>
          <div class="controls" data-controls hidden>
            <div class="ctl">
              <span class="ctl-label" id="lbl-size">{live.rent.size}</span>
              <div class="pills" role="group" aria-labelledby="lbl-size">
                {
                  [40, 60, 90].map((m) => (
                    <button type="button" class="pill-btn" data-k="size" data-v={m} aria-pressed={m === 60 ? 'true' : 'false'}>
                      {m} m²
                    </button>
                  ))
                }
              </div>
            </div>
            <label class="ctl range">
              <span class="ctl-label">{live.rent.budget} <output>€2,000</output></span>
              <input type="range" min="1000" max="4000" step="100" value="2000" data-k="budget" data-fmt="€{n}" />
            </label>
          </div>
          <p class="readout" data-readout="rent" aria-live="polite"></p>
          <p class="source">{layers[1]!.source}</p>
        </div>
      </article>

      <article class="step" id="layer-noise" data-layer="noise">
        <div class="card">
          <h3>{layers[2]!.name}</h3>
          <p>{layers[2]!.text}</p>
          <div class="controls" data-controls hidden>
            <div class="ctl">
              <span class="ctl-label" id="lbl-from">{live.noise.sources}</span>
              <div class="pills" role="group" aria-labelledby="lbl-from">
                {
                  Object.entries(live.noise.kinds).map(([id, name]) => (
                    <button type="button" class="pill-btn" data-k="sources" data-v={id} aria-pressed="true">
                      {name}
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="ctl">
              <span class="ctl-label" id="lbl-level">{live.noise.level}</span>
              <div class="pills" role="group" aria-labelledby="lbl-level">
                {
                  Object.entries(live.noise.levels).map(([db, name]) => (
                    <button type="button" class="pill-btn" data-k="level" data-v={db} aria-pressed={db === '65' ? 'true' : 'false'}>
                      {name}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
          <p class="readout" data-readout="noise" aria-live="polite"></p>
          <p class="source">{layers[2]!.source}</p>
        </div>
      </article>

      <article class="step" id="layer-near" data-layer="near">
        <div class="card">
          <h3>{layers[3]!.name}</h3>
          <p>{layers[3]!.text}</p>
          <div class="controls" data-controls hidden>
            <div class="ctl">
              <span class="ctl-label" id="lbl-near">{live.near.what}</span>
              <div class="pills" role="group" aria-labelledby="lbl-near">
                {
                  Object.entries(live.near.cats).map(([id, name]) => (
                    <button
                      type="button"
                      class="pill-btn"
                      data-k="cats"
                      data-v={id}
                      aria-pressed={id === 'supermarket' || id === 'park' ? 'true' : 'false'}
                    >
                      {name}
                    </button>
                  ))
                }
              </div>
            </div>
            <label class="ctl range">
              <span class="ctl-label">{live.near.within} <output>800 m</output></span>
              <input type="range" min="200" max="1500" step="100" value="800" data-k="within" data-fmt={live.near.metres} />
            </label>
          </div>
          <p class="readout" data-readout="near" aria-live="polite"></p>
          <p class="source">{layers[3]!.source}</p>
        </div>
      </article>

      <article class="step" id="layer-safety" data-layer="safety">
        <div class="card">
          <h3>{layers[4]!.name}</h3>
          <p>{layers[4]!.text}</p>
          <div class="controls" data-controls hidden>
            <div class="ctl">
              <span class="ctl-label" id="lbl-night">{live.safety.show}</span>
              <div class="pills" role="group" aria-labelledby="lbl-night">
                {
                  Object.entries(live.safety.kinds).map(([id, name]) => (
                    <button type="button" class="pill-btn" data-k="night" data-v={id} aria-pressed="true">
                      {name}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
          <p class="readout" data-readout="safety" aria-live="polite"></p>
          <p class="source note" data-bars></p>
          <p class="source note">{live.safety.note}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section reason">
    <div class="wrap reason-grid">
      <div class="reason-copy">
        <h2 class="h2">{t.reason.title}</h2>
        <p class="lead">{t.reason.lead}</p>
        <ul class="points">
          {
            t.reason.points.map(([title, text]) => (
              <li>
                <strong>{title}</strong> {text}
              </li>
            ))
          }
        </ul>
        <a class="btn btn-quiet link" href="/demo/">
          {t.reason.try}
          <span class="arrow"><Icon name="arrow" size={14} /></span>
        </a>
      </div>
      <figure class="panel-shot">
        <img src="/img/demo-panel.webp" width="720" height="1250" alt={t.reason.shotAlt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section cities" id="cities">
    <div class="wrap">
      <div class="head">
        <h2 class="h2">{t.cities.title}</h2>
        <p class="lead">{t.cities.lead}</p>
      </div>
      <ul class="city-list">
        {
          CITIES.map((c) => (
            <li class:list={['city', c.status]}>
              <span class="city-name">{c.name}</span>
              <span class="city-country">{c.country}</span>
              {c.status === 'demo' ? (
                <a class="pill live" href="/demo/">
                  <span class="dot" aria-hidden="true" />
                  {t.cities.demo}
                  <span class="visually-hidden">: {t.cities.open}</span>
                </a>
              ) : (
                <span class="pill">{t.cities.soon}</span>
              )}
            </li>
          ))
        }
        <li class="city app">
          <span class="city-name">
            <Icon name="phone" size={20} />
            {t.cities.app}
          </span>
          <span class="city-app-text">{t.cities.appText}</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section data" id="data">
    <div class="wrap data-grid">
      <div>
        <h2 class="h2">{t.data.title}</h2>
        <p class="lead">{t.data.lead}</p>
      </div>
      <div class="table-wrap">
        <table>
          <caption class="visually-hidden">{t.data.note}</caption>
          <tbody>
            {
              t.data.sources.map(([layer, who, licence]) => (
                <tr>
                  <th scope="row">{layer}</th>
                  <td>{who}</td>
                  <td class="licence">{licence}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="note">{t.data.note}</p>
      </div>
    </div>
  </section>

  <section class="section join" id="waitlist">
    <div class="wrap join-grid">
      <div class="join-copy">
        <h2 class="h2">{t.form.title}</h2>
        <p class="lead">{t.form.lead}</p>
      </div>
      <div class="join-card">
        <WaitlistForm locale={locale} />
      </div>
    </div>
  </section>
</Base>

<script>
  // Scroll story: the step crossing the reading line picks the map layer; the dock follows and jumps.
  import type { LayerId } from '../scripts/live-map';

  const root = document.querySelector<HTMLElement>('[data-story]')!;
  const strings = JSON.parse(document.getElementById('live-strings')!.textContent!);
  const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
  const steps = Array.from(root.querySelectorAll<HTMLElement>('.step[data-layer]'));
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = () => innerWidth >= 900;

  let current: LayerId | '' = '';
  let live: { setLayer: (id: LayerId) => void } | null = null;

  const pick = () => {
    const line = innerHeight * (wide() ? 0.6 : 0.9);
    let id: LayerId = 'overview';
    for (const step of steps) {
      if ((step.querySelector('.card') ?? step).getBoundingClientRect().top < line) id = step.dataset.layer as LayerId;
    }
    if (id === current) return;
    current = id;
    root.dataset.layer = id;
    for (const step of steps) step.classList.toggle('is-active', step.dataset.layer === id);
    for (const tab of tabs) {
      if (tab.dataset.tab === id) tab.setAttribute('aria-current', 'step');
      else tab.removeAttribute('aria-current');
    }
    live?.setLayer(id);
  };

  let ticking = false;
  addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        pick();
      });
    },
    { passive: true },
  );
  addEventListener('resize', pick);
  pick();

  for (const tab of tabs) {
    tab.addEventListener('click', (e) => {
      const card = document.getElementById(`layer-${tab.dataset.tab}`)?.querySelector('.card');
      if (!card) return;
      e.preventDefault();
      card.scrollIntoView({ block: wide() ? 'center' : 'end', behavior: reduced ? 'auto' : 'smooth' });
    });
  }

  import('../scripts/live-map')
    .then(({ mountLiveMap }) => mountLiveMap(root, strings, () => {}))
    .then((api) => {
      live = api;
      if (current) api.setLayer(current);
      for (const el of root.querySelectorAll<HTMLElement>('[data-controls]')) el.hidden = false;
      root.classList.add('is-live');
      status.textContent = '';
    })
    .catch((err) => {
      console.warn('live map', err);
      status.textContent = strings.failed;
      root.classList.add('is-failed');
    });
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(48px, 8vw, 104px);
  }

  .hero-copy {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.6rem, 1.4rem + 5.2vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 1;
    max-width: 14ch;
  }

  .hero-lead {
    margin-top: 28px;
    max-width: 60ch;
    color: #b4bcc6;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.55;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 20px;
    margin-top: 36px;
  }

  .status-line {
    display: block;
    margin-top: 28px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .status-line .dot {
    display: inline-block;
    margin-right: 10px;
    vertical-align: 1px;
  }

  .dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 999px;
    background: var(--fit);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--fit) 22%, transparent);
  }

  /* Story: a sticky live map; the layer steps scroll over it and pick what it shows. */
  .story {
    --stage-top: 80px;
    overflow-x: clip;
    --card-w: 384px;
    position: relative;
    display: grid;
    width: 100%;
    max-width: calc(var(--wrap) + var(--gutter) * 2);
    margin: clamp(48px, 6vw, 72px) auto 0;
    padding-inline: var(--gutter);
  }

  .story::before {
    content: '';
    position: absolute;
    inset: -4% -12% auto;
    height: 90svh;
    mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 55%, transparent 92%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 55%, transparent 92%);
    background:
      radial-gradient(38% 46% at 40% 50%, color-mix(in srgb, var(--fit) 34%, transparent), transparent 72%),
      radial-gradient(40% 52% at 62% 46%, color-mix(in srgb, var(--accent) 40%, transparent), transparent 72%);
    filter: blur(24px);
    pointer-events: none;
  }

  .stage,
  .steps {
    grid-area: 1 / 1;
  }

  .stage {
    position: sticky;
    top: var(--stage-top);
    align-self: start;
    height: min(calc(100svh - var(--stage-top) - 16px), 860px);
  }

  .frame {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    background: var(--bg-raise);
    padding: 0 8px 8px;
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.75),
      0 0 0 6px color-mix(in srgb, var(--bg-soft) 60%, transparent);
    animation: rise 1.1s var(--ease-out) both;
  }

  @keyframes rise {
    from {
      transform: translateY(32px) scale(0.985);
      filter: blur(6px);
    }
    to {
      transform: none;
      filter: none;
    }
  }

  .frame-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 40px;
    flex: none;
    padding-inline: 8px 4px;
  }

  .frame-bar > span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--line-strong);
  }

  .frame-bar p {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .frame-bar .dot {
    width: 6px;
    height: 6px;
    box-shadow: none;
    opacity: 0.4;
    transition: opacity 0.4s var(--ease-out);
  }

  .is-live .frame-bar .dot {
    opacity: 1;
  }

  .frame-open {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 10px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }

  .frame-open:hover {
    color: var(--fg-strong);
  }

  .map-shell {
    position: relative;
    flex: 1;
    min-height: 0;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #0d1116;
  }

  .map {
    position: absolute;
    inset: 0;
    background: #0d1116;
  }

  .map:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .poster {
    position: absolute;
    inset: 0;
    transition:
      opacity 0.6s var(--ease-out),
      visibility 0.6s;
  }

  .poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .is-live .poster {
    opacity: 0;
    visibility: hidden;
  }

  .map-status {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg-raise) 92%, transparent);
    color: var(--fg);
    font-size: 0.875rem;
    text-align: center;
  }

  .map-status:empty {
    display: none;
  }

  .is-failed .map-status {
    max-width: calc(100% - 32px);
    border-radius: var(--radius);
  }

  .legend {
    position: absolute;
    z-index: 500;
    top: 12px;
    right: 60px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 14px;
    max-width: calc(100% - var(--card-w) - 120px);
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg-raise) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--fg);
    font-size: 0.8125rem;
    line-height: 1.3;
    pointer-events: none;
  }

  .legend:empty {
    display: none;
  }

  .legend :global(span) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }

  .legend :global(i) {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }

  .move {
    position: absolute;
    z-index: 500;
    top: 12px;
    left: 12px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg-raise) 92%, transparent);
    color: var(--fg-strong);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .move[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .dock {
    position: absolute;
    z-index: 600;
    left: 50%;
    bottom: 24px;
    transform: translateX(calc(-50% + var(--card-w) / 2 + 12px));
    display: flex;
    gap: 4px;
    padding: 5px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg-raise) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.8);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.875rem;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out);
  }

  .tab:hover {
    color: var(--fg-strong);
  }

  .tab[aria-current='step'] {
    background: var(--fg-strong);
    color: var(--bg);
  }

  .steps {
    position: relative;
    z-index: 1;
    pointer-events: none;
    padding: 0 20px;
  }

  .step {
    display: flex;
    align-items: center;
    min-height: 88svh;
  }

  .step.intro {
    min-height: 62svh;
    align-items: flex-end;
  }

  .step:last-child {
    min-height: 100svh;
  }

  .card {
    pointer-events: auto;
    width: min(var(--card-w), 100%);
    padding: 24px;
    border-radius: var(--radius-lg);
