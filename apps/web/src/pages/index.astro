---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { CITIES } from '../config';
import { useStrings } from '../i18n';

const locale = Astro.currentLocale ?? 'en';
const t = useStrings(locale);
const layers = t.layers.items;
---

<Base title={t.meta.title} description={t.meta.description} locale={locale}>
  <section class="hero">
    <div class="wrap hero-copy">
      <h1>{t.hero.title}</h1>
      <p class="hero-lead">{t.hero.lead}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#waitlist">
          {t.hero.cta}
          <span class="arrow"><Icon name="arrow" size={14} /></span>
        </a>
        <a class="btn btn-quiet" href="/demo/">
          {t.hero.demo}
          <span class="arrow"><Icon name="external" size={14} /></span>
        </a>
      </div>
      <p class="status-line">
        <span class="dot" aria-hidden="true"></span>
        {t.hero.status}
      </p>
    </div>

    <div class="wrap stage" id="how">
      <figure class="frame">
        <div class="frame-bar" aria-hidden="true">
          <span></span><span></span><span></span>
          <p>Luxembourg · demo</p>
        </div>
        <a class="shot" href="/demo/" tabindex="-1">
          <picture>
            <source media="(max-width: 640px)" srcset="/img/demo-mobile-780.webp" width="780" height="1688" />
            <img
              src="/img/demo-results-1200.webp"
              srcset="/img/demo-results-1200.webp 1200w, /img/demo-results-2400.webp 2400w"
              sizes="(max-width: 1260px) 92vw, 1180px"
              width="2400"
              height="1500"
              alt={t.hero.shotAlt}
              fetchpriority="high"
            />
          </picture>
        </a>
      </figure>

      <div class="layers">
        <div class="tabs" role="tablist" aria-label={t.layers.label}>
          {
            layers.map((l, i) => (
              <button
                class="tab"
                role="tab"
                id={`tab-${l.id}`}
                aria-controls={`panel-${l.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                type="button"
              >
                <Icon name={l.id as 'commute'} size={18} />
                <span>{l.name}</span>
              </button>
            ))
          }
        </div>
        {
          layers.map((l, i) => (
            <div class="panel" role="tabpanel" id={`panel-${l.id}`} aria-labelledby={`tab-${l.id}`} hidden={i !== 0}>
              <p class="panel-text">{l.text}</p>
              <p class="panel-source">{l.source}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section reason">
    <div class="wrap reason-grid">
      <div class="reason-copy">
        <h2 class="h2">{t.reason.title}</h2>
        <p class="lead">{t.reason.lead}</p>
        <ul class="points">
          {
            t.reason.points.map(([title, text]) => (
              <li>
                <strong>{title}</strong> {text}
              </li>
            ))
          }
        </ul>
        <a class="btn btn-quiet link" href="/demo/">
          {t.reason.try}
          <span class="arrow"><Icon name="arrow" size={14} /></span>
        </a>
      </div>
      <figure class="panel-shot">
        <img src="/img/demo-panel.webp" width="720" height="1250" alt={t.reason.shotAlt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section cities" id="cities">
    <div class="wrap">
      <div class="head">
        <h2 class="h2">{t.cities.title}</h2>
        <p class="lead">{t.cities.lead}</p>
      </div>
      <ul class="city-list">
        {
          CITIES.map((c) => (
            <li class:list={['city', c.status]}>
              <span class="city-name">{c.name}</span>
              <span class="city-country">{c.country}</span>
              {c.status === 'demo' ? (
                <a class="pill live" href="/demo/">
                  <span class="dot" aria-hidden="true" />
                  {t.cities.demo}
                  <span class="visually-hidden">: {t.cities.open}</span>
                </a>
              ) : (
                <span class="pill">{t.cities.soon}</span>
              )}
            </li>
          ))
        }
        <li class="city app">
          <span class="city-name">
            <Icon name="phone" size={20} />
            {t.cities.app}
          </span>
          <span class="city-app-text">{t.cities.appText}</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section data" id="data">
    <div class="wrap data-grid">
      <div>
        <h2 class="h2">{t.data.title}</h2>
        <p class="lead">{t.data.lead}</p>
      </div>
      <div class="table-wrap">
        <table>
          <caption class="visually-hidden">{t.data.note}</caption>
          <tbody>
            {
              t.data.sources.map(([layer, who, licence]) => (
                <tr>
                  <th scope="row">{layer}</th>
                  <td>{who}</td>
                  <td class="licence">{licence}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="note">{t.data.note}</p>
      </div>
    </div>
  </section>

  <section class="section join" id="waitlist">
    <div class="wrap join-grid">
      <div class="join-copy">
        <h2 class="h2">{t.form.title}</h2>
        <p class="lead">{t.form.lead}</p>
      </div>
      <div class="join-card">
        <WaitlistForm locale={locale} />
      </div>
    </div>
  </section>
</Base>

<script>
  // Layer tabs: click or arrow keys switch the caption under the demo screenshot.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.layers [role="tab"]'));
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    }
    if (focus) tab.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (e.key === 'Home') select(tabs[0]!, true);
      else if (e.key === 'End') select(tabs[tabs.length - 1]!, true);
      else if (step) select(tabs[(i + step + tabs.length) % tabs.length]!, true);
      else return;
      e.preventDefault();
    });
  });
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(48px, 8vw, 104px);
    overflow: clip;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 38% -20% auto;
    height: 80%;
    background:
      radial-gradient(38% 46% at 40% 50%, color-mix(in srgb, var(--fit) 34%, transparent), transparent 72%),
      radial-gradient(40% 52% at 62% 46%, color-mix(in srgb, var(--accent) 40%, transparent), transparent 72%);
    filter: blur(24px);
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.6rem, 1.4rem + 5.2vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 1;
    max-width: 14ch;
  }

  .hero-lead {
    margin-top: 28px;
    max-width: 60ch;
    color: #b4bcc6;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.55;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 20px;
    margin-top: 36px;
  }

  .status-line {
    display: block;
    margin-top: 28px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .status-line .dot {
    display: inline-block;
    margin-right: 10px;
    vertical-align: 1px;
  }

  .dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 999px;
    background: var(--fit);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--fit) 22%, transparent);
  }

  .stage {
    position: relative;
    margin-top: clamp(48px, 6vw, 72px);
  }

  .frame {
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    background: var(--bg-raise);
    padding: 0 8px 8px;
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.75),
      0 0 0 6px color-mix(in srgb, var(--bg-soft) 60%, transparent);
    animation: rise 1.1s var(--ease-out) both;
  }

  @keyframes rise {
    from {
      transform: translateY(32px) scale(0.985);
      filter: blur(6px);
    }
    to {
      transform: none;
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame {
      animation: none;
    }
  }

  .frame-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 40px;
    padding-inline: 8px;
  }

  .frame-bar span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--line-strong);
  }

  .frame-bar p {
    margin-left: auto;
    margin-right: auto;
    transform: translateX(-24px);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .shot {
    display: block;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .shot img {
    width: 100%;
  }

  .layers {
    position: relative;
    margin-top: -32px;
    display: grid;
    justify-items: center;
    gap: 20px;
  }

  .tabs {
    display: flex;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg-raise) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.8);
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.9375rem;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  .tab:hover {
    color: var(--fg-strong);
  }

  .tab[aria-selected='true'] {
    background: var(--fg-strong);
    color: var(--bg);
  }

  .panel {
    text-align: center;
    max-width: 62ch;
    animation: fade 0.45s var(--ease-out);
  }

  @keyframes fade {
    from {
      transform: translateY(6px);
      opacity: 0.4;
    }
  }

  .panel-text {
    color: var(--fg);
    font-size: 1.125rem;
  }

  .panel-source {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  /* Reason */
  .reason-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .reason-copy .lead {
    margin-top: 24px;
  }

  .points {
    list-style: none;
    padding: 0;
    margin: 40px 0 32px;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .points li {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .points strong {
    color: var(--fg-strong);
    font-weight: 560;
  }

  .link {
    padding-inline: 0;
    color: var(--accent);
  }

  .panel-shot {
    margin: 0;
    justify-self: center;
    width: min(100%, 400px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    overflow: hidden;
    background: var(--bg-raise);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.9);
    position: relative;
  }

  .panel-shot img {
    width: 100%;
  }

  /* Cities */
  .head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 64px;
    align-items: end;
    margin-bottom: 48px;
  }

  .city-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .city {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 4px 16px;
    align-items: center;
    padding: 24px;
    min-height: 112px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .city-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg-strong);
    font-size: 1.375rem;
    font-weight: 540;
    letter-spacing: -0.025em;
  }

  .city-country {
    grid-row: 2;
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .pill {
    grid-row: 1 / span 2;
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    font-size: 0.8125rem;
    white-space: nowrap;
    text-decoration: none;
  }

  .pill.live {
    color: var(--fg-strong);
    border-color: color-mix(in srgb, var(--fit) 55%, transparent);
    background: color-mix(in srgb, var(--fit) 12%, transparent);
  }

  .pill.live:hover {
    background: color-mix(in srgb, var(--fit) 20%, transparent);
    color: var(--fg-strong);
  }

  .pill .dot {
    width: 6px;
    height: 6px;
    box-shadow: none;
  }

  .city.demo {
    background: color-mix(in srgb, var(--fit) 5%, transparent);
  }

  .city.app {
    grid-column: 1 / -1;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto;
    min-height: 0;
    background: var(--bg-raise);
  }

  .city-app-text {
    color: var(--muted);
  }

  /* Data */
  .data {
    background: var(--bg-raise);
    border-block: 1px solid var(--line);
  }

  .data-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px clamp(40px, 6vw, 96px);
  }

  .data-grid .lead {
    margin-top: 24px;
  }

  .table-wrap {
    min-width: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--line);
  }

  tr:first-child th,
  tr:first-child td {
    border-top: 1px solid var(--line);
  }

  th {
    color: var(--fg-strong);
    font-weight: 540;
    width: 30%;
  }

  td {
    color: var(--muted);
  }

  .licence {
    padding-right: 0;
    text-align: right;
    white-space: nowrap;
    color: var(--fg);
    font-size: 0.8125rem;
  }

  .note {
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  /* Join */
  .join-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .join-copy .lead {
    margin-top: 24px;
  }

  .join-card {
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    background: var(--bg-raise);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.9);
  }

  @media (max-width: 960px) {
    .reason-grid,
    .data-grid,
    .join-grid,
    .head {
      grid-template-columns: 1fr;
    }

    .city-list {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 640px) {
    .frame {
      padding: 0 6px 6px;
      max-width: 400px;
      margin-inline: auto;
    }

    .frame-bar {
      height: 32px;
    }

    .layers {
      margin-top: -26px;
      justify-items: stretch;
    }

    .tabs {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 2px;
      padding: 4px;
      border-radius: 18px;
    }

    .tab {
      flex-direction: column;
      gap: 4px;
      min-height: 58px;
      padding: 6px 2px;
      border-radius: 14px;
      font-size: 0.75rem;
      white-space: normal;
      line-height: 1.15;
      text-align: center;
    }

    .panel {
      text-align: left;
    }

    .city-list {
      grid-template-columns: 1fr;
    }

    .city.app {
      grid-template-columns: 1fr;
    }

    .city {
      padding: 20px;
      min-height: 0;
    }

    th {
      width: 34%;
    }

    .licence {
      white-space: normal;
      max-width: 7em;
    }
  }
</style>
