{
  "name": "@wtl/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-demo": "node scripts/copy-demo.mjs",
    "predev": "node scripts/copy-demo.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-demo.mjs",
    "build": "astro build",
    "preview": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply wtl-waitlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply wtl-waitlist --remote",
    "test": "vitest run",
    "typecheck": "astro check && tsc -p functions/tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261009.1",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
