{
  "name": "@wtl/data-lux",
  "version": "0.1.0",
  "private": true,
  "description": "Luxembourg dataset (grid, areas, POIs, transit) converted from prototipo/data",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./grid.json": {
      "types": "./src/grid.json.d.ts",
      "default": "./data/grid.json"
    },
    "./areas.json": {
      "types": "./src/areas.json.d.ts",
      "default": "./data/areas.json"
    },
    "./pois.json": {
      "types": "./src/pois.json.d.ts",
      "default": "./data/pois.json"
    },
    "./transit.json": {
      "types": "./src/transit.json.d.ts",
      "default": "./data/transit.json"
    },
    "./meta.json": {
      "types": "./src/meta.json.d.ts",
      "default": "./data/meta.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "data"
  ],
  "scripts": {
    "convert": "node scripts/convert.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "^5.0.3"
  }
}
